# =============================================================================
# Ride-Hailing Platform — Staging Environment Variables Template
# Copy to Railway / Staging Server Secrets Manager
# =============================================================================

PORT=8080
ENV=staging

# Staging PostgreSQL (Managed Cloud DB)
DATABASE_URL=postgres://ride_user:staging_secret@staging-db.rides.rw:5432/rideplatform?sslmode=require

# Staging Redis
REDIS_URL=redis://staging-redis:6379

# JWT Secrets
JWT_ACCESS_SECRET=staging_jwt_access_secret_change_me_0123456789
JWT_REFRESH_SECRET=staging_jwt_refresh_secret_change_me_0123456789
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=30

# OTP SMS Delivery
SMS_PROVIDER=pindo
OTP_MODE=self_sms
PINDO_API_TOKEN=your_pindo_staging_token
PINDO_SENDER=Rides
PINDO_VERIFY_BRAND=Rides

# Firebase Cloud Messaging (FCM)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Object Storage (Cloudflare R2 Staging Bucket)
STORAGE_PROVIDER=r2
STORAGE_BUCKET=rides-docs-staging
STORAGE_REGION=auto
STORAGE_KEY_ID=your_cloudflare_r2_staging_key_id
STORAGE_SECRET=your_cloudflare_r2_staging_secret
STORAGE_ACCOUNT_ID=your_cloudflare_account_id
STORAGE_CDN_URL=https://stg-cdn.rides.rw
